Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Configure the canonical HTTP-to-HTTPS redirect in the Apache virtual host.
    # Refuse non-TLS requests here rather than redirecting to an untrusted Host.
    # Loopback is used only by the explicitly configured local environment.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ - [F]
    RewriteRule (^|/)\.(?!well-known/) - [F]
</IfModule>

<FilesMatch "\.(sql|sqlite|db|log|ini|bak|env|md)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
    Header always set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

LimitRequestBody 3145728

<Files app.html>
    Require all denied
</Files>
