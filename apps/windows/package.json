{
  "name": "nute-desktop",
  "productName": "Nute Notes",
  "version": "0.5.0",
  "description": "Личные зашифрованные заметки NUTE",
  "author": "Nute Notes contributors",
  "private": true,
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "prepare:ui": "node scripts/prepare-ui.mjs",
    "start": "npm run prepare:ui && electron .",
    "test": "node --test tests/*.test.mjs",
    "smoke": "npm run prepare:ui && electron . --nute-smoke",
    "dist": "npm run prepare:ui && electron-builder --win nsis --x64 --publish never",
    "pack": "npm run prepare:ui && electron-builder --win --x64 --dir --publish never"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.nutenotes.app",
    "productName": "Nute Notes",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "src/**",
      "ui/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "ui/assets/nute-logo.png",
      "artifactName": "Nute-Notes-${version}-Windows-x64-Setup.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/mrnuked/nute-notes",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrnuked/nute-notes.git"
  }
}
