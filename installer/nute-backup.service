[Unit]
Description=Back up NUTE database and private configuration
After=mysql.service
Requires=mysql.service
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nute-backup
User=root
UMask=0077
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/nute /run/lock
